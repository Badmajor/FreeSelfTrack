# Local Docker Compose defaults. Replace credentials before any shared deployment.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Local Compose derives its database URL from POSTGRES_* when this override is absent.
# Shared deployments: provision a separate runtime role and use deploy/compose.runtime.yml.
# Migrate separately as the trusted owner; see docs/development/administration-release.md.
# TRACKER_DATABASE_URL=postgresql+asyncpg://tracker_runtime:URL_ENCODED_PASSWORD@db:5432/tracker

# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=
DEADLINE_WORKER_INTERVAL_SECONDS=60

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-minio-password
S3_BUCKET=tracker-attachments
ATTACHMENT_UPLOAD_SLOTS=2
ATTACHMENT_DOWNLOAD_SLOTS=4

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173

# SMTP confirms self-service email changes; account creation/reset are administrative.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_HOST=localhost
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.com
# Exact trusted reverse-proxy IP/CIDRs as a JSON list; never trust public clients.
# Empty means all clients behind the proxy share its address rate limit (fail-safe).
TRUSTED_PROXY_NETWORKS=[]

# Background malware scanning (ClamAV stays on the internal network).
ATTACHMENT_SCAN_INTERVAL_SECONDS=5
ATTACHMENT_SCAN_TIMEOUT_SECONDS=60

# Required on API and workers, with no TRACKER_ prefix; use identical values on replicas.
# Bootstrap changes credentials/role; it does not restore revoked memberships.
# Set locally, never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
