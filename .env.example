# Local Docker Compose defaults. Replace credentials before any shared deployment.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tacker
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5431

# Backend runtime URL. In Compose, db:5432 is the internal service address.
TRACKER_DATABASE_URL=postgresql+asyncpg://tracker:change-me-local-db-password@db:5432/tracker

AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DEADLINE_WORKER_INTERVAL_SECONDS=60

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-minio-password

FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173
